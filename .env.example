# Valores exclusivamente locales de la demo.
POSTGRES_PASSWORD=umbral_local
WEB_PORT=8088
# Dirección de esta computadora visible desde los celulares de la misma red.
# Si abrís la mesa en localhost, se usará para el QR de invitación.
SHARE_ORIGIN=
# Origen HTTPS público opcional sugerido para invitaciones de partidas online.
# En Docker Compose se copia al build web como VITE_ONLINE_ORIGIN.
# El hostname de un Quick Tunnel cambia al reiniciarlo; podés editarlo en el lobby.
ONLINE_ORIGIN=
# Orígenes adicionales separados por coma; el mismo origen se acepta automáticamente.
APP_ORIGINS=
# Para desarrollo fuera de Docker:
DATABASE_URL=postgres://umbral:umbral_local@127.0.0.1:5434/umbral
